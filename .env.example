# PharmaGPT — environment variable reference.
# Copy to .env for local dev and fill in real values. Never commit .env
# (already in .gitignore). See docs/DEPLOYMENT.md for the Render production
# equivalent of this file (render.yaml's envVars block).

# ── Required — app will not start / auth will fail without these ─────────────

# Google Gemini API key. All AI features (chat, document generation, AI
# review, QMS assistants) fail without it. Required when AI_PROVIDER=gemini
# (the default) — see AI_PROVIDER below.
GEMINI_API_KEY=

# ── AI provider (pharmagpt/providers/factory.py) ─────────────────────────────
# "gemini" (default, or leave unset) — unchanged behavior. "nemotron" routes
# all AI generation through NVIDIA's Nemotron 3 Ultra API instead, requiring
# NVIDIA_API_KEY and NVIDIA_MODEL below.
AI_PROVIDER=gemini

# NVIDIA API key (https://build.nvidia.com/) — starts with "nvapi-". Only
# required when AI_PROVIDER=nemotron.
NVIDIA_API_KEY=

# Exact NVIDIA model catalog slug to call. No default — required when
# AI_PROVIDER=nemotron. Verified current slug for Nemotron 3 Ultra on the
# hosted catalog API (build.nvidia.com), at time of writing:
#   nvidia/nemotron-3-ultra-550b-a55b
# Confirm against build.nvidia.com before deploying — NVIDIA may add
# versioned or renamed variants.
NVIDIA_MODEL=

# Supabase project — read on every authenticated request
# (pharmagpt/auth/context.py -> pharmagpt/services/supabase_client.py).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Required since Phase 3.5 (Company Administration) — pharmagpt/services/
# identity_admin.py::provision_user() (called live by POST /companies and
# POST /users) uses this to mint new Supabase Auth identities, bypassing RLS.
# This is a live HTTP-reachable code path, NOT a CLI-only script dependency
# (see the corrected note in the "CLI-only" section below). Never commit a
# real value; treat it like a database root password.
SUPABASE_SERVICE_ROLE_KEY=

# Signs the Flask session cookie. REQUIRED outside local development — the
# app now refuses to start without it unless FLASK_DEBUG=true (in which case
# a temporary in-memory secret is generated for you, with a warning; never
# suitable for production). Set a real random value in any shared or
# production environment. Render's render.yaml auto-generates this.
FLASK_SECRET_KEY=

# ── Local dev only ─────────────────────────────────────────────────────────

# Defaults to "false" (fail-safe) if unset. Set explicitly to "true" for
# local dev to get the Werkzeug debugger + auto-reload. Must stay "false" (or
# unset) in production — "true" enables the interactive debugger (arbitrary
# code execution) and disables the secure session cookie flag.
FLASK_DEBUG=true

# Only used by the `python pharmagpt/app.py` / `flask run` dev entrypoint —
# gunicorn (Procfile/render.yaml) binds via --bind 0.0.0.0:$PORT instead.
FLASK_PORT=5000

# ── Storage paths — override in production to point at a persistent disk ────
# All three default to paths inside the repo checkout, which is fine for
# local dev but is wiped on every redeploy on an ephemeral filesystem (e.g.
# Render without these set to the mounted disk). See render.yaml.

# DB_PATH=/var/data/pharmagpt.db
# UPLOAD_FOLDER=/var/data/uploads
# GENERATED_DOCS_PATH=/var/data/generated_documents

# ── Phase 3 Postgres migration flags — leave unset / "sqlite" ────────────────
# Each defaults to "sqlite" (SQLite is the sole source of truth). "dual"
# additionally best-effort mirrors writes to Postgres. Do NOT set any of
# these to "dual" outside a real Staging soak — cutover is gated on an
# extended soak + 2-company RLS isolation check per domain, not yet done.
# See docs/PHASE3_EXECUTION_PLAN.md §3.6 and docs/PHASE3_FLAGS.md.
# DATABASE_BACKEND=sqlite
# PROJECTS_BACKEND=sqlite
# KB_BACKEND=sqlite
# EQUIPMENT_BACKEND=sqlite
# QMS_BACKEND=sqlite

# ── Tuning — all optional, sane defaults shown ────────────────────────────────
# PAGE_TIMEOUT_SECONDS=10
# EXTRACTION_WORKERS=2
# GC_INTERVAL_PAGES=20
# PROGRESS_WRITE_EVERY_N_PAGES=5
# URS_GENERATION_BATCH_SIZE=2
# URS_GENERATION_SLOW_WARNING_SECONDS=20
# URS_GENERATION_MAX_RETRIES=2

# ── Backup & Recovery (pharmagpt/services/backup_service.py) ─────────────────
# See docs/BACKUP_SOP.md §4 "One-time setup" before running scripts/run_backup.py.

# REQUIRED before any backup/restore/verify will run — has NO default, unlike
# FLASK_SECRET_KEY above (a security-critical key must never silently
# default). Generate with: python scripts/generate_backup_key.py
# BACKUP_ENCRYPTION_KEY=

# BACKUP_DIR=./backups
# BACKUP_OFFSITE_DIR=
# BACKUP_ALERT_WEBHOOK_URL=
# BACKUP_FREQUENCY_HOURS=6
# BACKUP_SNAPSHOT_RETENTION_DAYS=7
# BACKUP_DAILY_RETENTION_DAYS=365

# Set to "true" only once an external scheduler (Render Cron Job, OS cron,
# etc.) actually calls scripts/run_backup.py on a schedule — this is a
# statement of configured intent PharmaGPT cannot itself verify, used to
# show a "Scheduler: configured" state on the /admin/backup dashboard and
# to estimate the "Next Scheduled Backup" time. Leaving it "false" (the
# default) is correct and expected until a scheduler is actually wired up.
# BACKUP_SCHEDULER_ENABLED=false

# Optional — only used if the pg_dump binary is also on PATH; the primary
# Postgres backup mechanism (PostgREST JSON export) does not need this.
# SUPABASE_DB_URL=

# ── CLI-only — never read by the running web app, no HTTP route depends ─────
# on these. Only needed when running the scripts below directly.
# (Correction, Phase F.2: SUPABASE_SERVICE_ROLE_KEY was listed here until
# Phase 3.5 added a live web-app dependency on it — see the "Required"
# section above. scripts/check_*_parity.py and scripts/backfill_*.py also
# still use it directly for their own client construction; that use is
# unaffected by this correction.)

# scripts/bootstrap_super_admin.py (one-time super-admin account creation)
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_PASSWORD=
# SUPER_ADMIN_DISPLAY_NAME=Super Admin
